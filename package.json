{
  "name": "solar-wiresim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-solver.mjs",
    "predev": "node scripts/patch-solver.mjs",
    "prebuild": "node scripts/patch-solver.mjs",
    "pretest": "node scripts/patch-solver.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --loader ./scripts/ts-esbuild-loader.mjs --test tests/*.test.mjs",
    "catalog:check": "node --loader ./scripts/ts-esbuild-loader.mjs scripts/catalog-check.mjs",
    "ui:check": "node scripts/workbench-browser-check.mjs",
    "ui:legacy": "node scripts/ui-check.mjs",
    "verify": "npm run typecheck && npm test && npm run catalog:check && npm run build && npm run ui:check && npm run ui:physical && npm run ui:touch && npm run ui:projects && npm run ui:diagnostics && npm run ui:recovery && npm run ui:large && npm run ui:controls && npm run ui:groups && npm run ui:designer && npm run ui:engineering && npm run ui:improvements && npm run ui:usability",
    "ui:physical": "node scripts/physical-browser-check.mjs",
    "ui:performance": "node --loader ./scripts/ts-esbuild-loader.mjs scripts/workbench-performance.mjs",
    "ui:touch": "node scripts/workbench-touch-check.mjs",
    "ui:projects": "node scripts/project-library-browser-check.mjs",
    "ui:diagnostics": "node --loader ./scripts/ts-esbuild-loader.mjs scripts/diagnostics-browser-check.mjs",
    "ui:recovery": "node scripts/recovery-browser-check.mjs",
    "ui:dev": "node scripts/dev-simulation-browser-check.mjs",
    "ui:controls": "node scripts/controls-browser-check.mjs",
    "ui:large": "node --loader ./scripts/ts-esbuild-loader.mjs scripts/large-system-browser-check.mjs",
    "ui:groups": "node scripts/groups-browser-check.mjs",
    "ui:designer": "node scripts/designer-browser-check.mjs",
    "ui:engineering": "node scripts/engineering-browser-check.mjs",
    "ui:usability": "node scripts/usability-browser-check.mjs",
    "ui:improvements": "node --loader ./scripts/ts-esbuild-loader.mjs scripts/requested-improvements-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "12.12.1",
    "eecircuit-engine": "1.9.0",
    "elkjs": "0.12.1",
    "jspdf": "4.2.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "suncalc": "2.1.4",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "6.4.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "^0.25.12"
  }
}
