{
  "name": "solar-wiresim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "catalog:check": "node --experimental-strip-types scripts/catalog-check.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "verify": "npm run typecheck && npm test && npm run catalog:check && npm run ui:check && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
